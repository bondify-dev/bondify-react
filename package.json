{
  "name": "@bondify/react",
  "version": "3.0.0",
  "description": "Telegram Login & authentication SDK for React and Next.js — drop-in login button, hooks, and webhook verification. By Bondify.",
  "keywords": [
    "telegram",
    "telegram-login",
    "telegram-auth",
    "telegram-oauth",
    "telegram-bot",
    "auth",
    "authentication",
    "sdk",
    "react",
    "react-hooks",
    "nextjs",
    "next-auth",
    "login-button",
    "bondify"
  ],
  "homepage": "https://bondify.dev",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/server.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "@bondify/node": "^3.0.0",
    "next": "^14.2.0 || ^15.0.0 || ^16.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@bondify/node": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@bondify/node": "^3.0.0",
    "@types/qrcode": "^1.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "next": "^15.5.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
